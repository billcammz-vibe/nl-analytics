# Anthropic API key used for SQL generation and result summaries
ANTHROPIC_API_KEY=sk-ant-...

# Model used for both SQL generation and summaries
CLAUDE_MODEL=claude-sonnet-5

# Safety limits (see README "Safety" section)
MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=10

# Where the CSV(s) live and where the read-only DuckDB warehouse file is built.
# The app only ever opens WAREHOUSE_PATH in read-only mode; writing to it only
# happens via data/build_warehouse.py.
DATA_DIR=data
WAREHOUSE_PATH=data/warehouse.duckdb
